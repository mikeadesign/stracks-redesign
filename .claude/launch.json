{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "stracks",
      "runtimeExecutable": "npm.cmd",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "stracks-static",
      "runtimeExecutable": "npx.cmd",
      "runtimeArgs": ["serve", "out", "-l", "4000"],
      "port": 4000,
      "autoPort": true
    }
  ]
}
